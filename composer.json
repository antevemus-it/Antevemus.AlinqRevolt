{
  "name": "antevemus/alinq-revolt",
  "description": "Asynchronous companion of antevemus/alinq-collection: selectAsync(), whereAsync(), selectManyAsync() and eachAsync() over the Revolt event loop (Fibers, Amp futures), with an ordered, bounded, lazy window of items in flight, returning core ALinq lazy collections",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/antevemus-it/Antevemus.AlinqRevolt",
  "support": {
    "source": "https://github.com/antevemus-it/Antevemus.AlinqRevolt",
    "issues": "https://github.com/antevemus-it/Antevemus.AlinqRevolt/issues",
    "docs": "https://github.com/antevemus-it/Antevemus.AlinqRevolt#readme"
  },
  "keywords": [
    "linq",
    "collection",
    "async",
    "fiber",
    "revolt",
    "amphp",
    "event-loop",
    "concurrency",
    "lazy",
    "php84"
  ],
  "authors": [
    {
      "name": "Heliton Junior - CTO @ Antevemus Soluções Inovadoras em TI Ltda.",
      "email": "contato@antevemus.com.br",
      "homepage": "https://antevemus.com.br"
    }
  ],
  "require": {
    "php": ">=8.4",
    "antevemus/alinq-collection": "^2.3",
    "revolt/event-loop": "^1.0",
    "amphp/amp": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "amphp/http-server": "^3.4",
    "amphp/http-client": "^5.3",
    "infection/infection": "^0.35.6"
  },
  "autoload": {
    "psr-4": {
      "Antevemus\\ALinqRevolt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Antevemus\\ALinqRevolt\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": false
    }
  }
}
